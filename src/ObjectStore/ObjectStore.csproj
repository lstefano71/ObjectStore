  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ObjectStore.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
